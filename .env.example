# =========================================================================
# InternPath - Environment Configuration Template (.env.example)
# Do NOT put real production API keys or session secrets in this file.
# Copy this file to '.env' and fill in your actual values before deploying.
# =========================================================================

# --- PostgreSQL Database ---
# Required. InternPath runs on PostgreSQL + pgvector only.
# Example: postgresql://app_user:app_password@localhost:5432/job_dashboard
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/job_dashboard

# --- Redis / RQ Background Jobs ---
# Required for async analysis, imports, and Agent resume optimization.
REDIS_URL=redis://localhost:6379/0
RQ_QUEUE_NAME=internpath-default
RQ_ADVISOR_QUEUE_NAME=internpath-advisor
RQ_JOB_TIMEOUT_SECONDS=1800
RQ_RESULT_TTL_SECONDS=86400
ADVISOR_EVENT_STREAM_MAXLEN=10000
ADVISOR_EVENT_STREAM_BLOCK_MILLISECONDS=800
ADVISOR_EVENT_STATUS_POLL_SECONDS=0.75
ADVISOR_AUTOSCALE_MIN_WORKERS=1
ADVISOR_AUTOSCALE_MAX_WORKERS=4
ADVISOR_AUTOSCALE_JOBS_PER_WORKER=2
ADVISOR_AUTOSCALE_POLL_SECONDS=5

# --- LangGraph orchestration ---
# postgres is required for durable interrupt/resume across RQ jobs and worker restarts.
# memory is intended only for isolated tests or single-process experiments.
LANGGRAPH_CHECKPOINTER=postgres
LANGGRAPH_POSTGRES_SETUP=true

# --- Agent cache ---
# file is simplest for local development; use redis or postgres for multi-worker deployments.
AGENT_CACHE_STORE=file
AGENT_CACHE_TTL_SECONDS=1209600
AGENT_CACHE_LOCK_TIMEOUT_SECONDS=10

# --- DOCX page-boundary visual check ---
# Crop current-page bottom / next-page top regions and flag obvious clipped text/table edges.
DOCX_BOUNDARY_REGION_RATIO=0.12
DOCX_BOUNDARY_EDGE_BAND_RATIO=0.04
DOCX_BOUNDARY_DARK_PIXEL_THRESHOLD=225
DOCX_BOUNDARY_MIN_EDGE_DARK_PIXELS=12
DOCX_BOUNDARY_MIN_EDGE_DARK_RATIO=0.0007
DOCX_BOUNDARY_HORIZONTAL_LINE_WIDTH_RATIO=0.32
DOCX_BOUNDARY_VERTICAL_LINE_HEIGHT_RATIO=0.65
DOCX_BOUNDARY_MIN_VERTICAL_EDGE_LINES=2
DOCX_BOUNDARY_SAVE_EVIDENCE=true
DOCX_BOUNDARY_EVIDENCE_DIR=
DOCX_BOUNDARY_LLM_ENABLED=true
DOCX_BOUNDARY_LLM_REQUIRED=false
DOCX_BOUNDARY_LLM_MODEL=gemini-1.5-flash
DOCX_BOUNDARY_LLM_BASE_URL=
DOCX_BOUNDARY_LLM_API_KEY=
DOCX_BOUNDARY_LLM_TEMPERATURE=0
DOCX_BOUNDARY_LLM_TIMEOUT=120

# --- Secure Session authentication Configuration ---
# Generate a secure 32-character random string for SESSION_SECRET.
# Example command to generate: openssl rand -hex 16
SESSION_SECRET=your_secure_random_session_secret_here

# --- API Key Encryption ---
# Used to encrypt user-owned API keys at rest. Generate with: openssl rand -hex 32
MODEL_SECRET_ENCRYPTION_KEY=your_model_secret_encryption_key_here

# --- Gemini API Proxy Gateway Config ---
# Real Gemini API Key (Backend-only. Hidden from browser)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Volcano Engine (Doubao) Embeddings Config ---
# Doubao API Key for Volcano Engine multimodal embedding API (Backend-only. Hidden from browser)
LLM_API_KEY=your_doubao_ark_api_key_here
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-1-5-pro-32k-250115
OPENAI_PROMPT_CACHE_ENABLED=true
OPENAI_PROMPT_CACHE_KEY_PREFIX=internpath
OPENAI_PROMPT_CACHE_RETENTION=24h
OPENAI_PROMPT_CACHE_STABLE_PREFIX_ENABLED=true
AGENT_HR_CRITIC_MAX_RETRIES_AUTO=0
AGENT_HR_CRITIC_MAX_RETRIES_COPILOT=1
AGENT_LLM_FACT_GUARD_ON_LOCAL_PASS=false

# --- Microservices Port Config ---
INTERNPATH_BACKEND_PORT=8787
INTERNPATH_WEB_PORT=5173
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
INTERNPATH_AI_PORT=8000

# --- Desktop Integration Path ---
PRACTICE_APP_PATH=C:\Path\To\AiSmartDrill.App.exe

# --- Environment ---
NODE_ENV=development

# --- Production CORS ---
# Required in production. Set to your deployed frontend URL.
# Example: https://internpath.example.com
FRONTEND_ORIGIN=

# --- Email Verification SMTP ---
# Brevo example:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USERNAME=your_brevo_login_email_or_smtp_username
# SMTP_PASSWORD=your_brevo_smtp_key
# MAIL_FROM=InternPath <noreply@yourdomain.com>
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=InternPath <noreply@internpath.local>
