n}\n\n.settings-editor-head {\n  margin-bottom: 14px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid var(--line);\n}\n\n.settings-editor-head h3 {\n  margin-bottom: 4px;\n}\n\n.settings-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 16px;\n}\n\n.api-key-input {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto auto;\n  gap: 8px;\n  align-items: center;\n}\n\n.api-key-input small {\n  grid-column: 1 / -1;\n  color: var(--subtle);\n  font-size: 11px;\n  font-weight: 650;\n}\n\n.model-card {\n  display: grid;\n  gap: 14px;\n  padding: 18px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n}\n\n.model-card-main {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  align-items: flex-start;\n}\n\n.model-card-main h3 {\n  margin-bottom: 4px;\n  font-size: 15px;\n}\n\n.model-card-main p {\n  margin-bottom: 10px;\n}\n\n.model-card-main small {\n  display: block;\n  margin-top: 8px;\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.model-card-actions,\n.model-test {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  align-items: center;\n}\n\n.model-test span {\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n.model-test-success span {\n  color: var(--success);\n}\n\n.model-test-failed span {\n  color: var(--danger);\n}\n\n.active-model-grid,\n.model-hint-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.model-hint-grid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.active-model-grid div,\n.model-hint-grid div {\n  min-width: 0;\n  padding: 12px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-sm);\n  background: var(--surface-muted);\n}\n\n.active-model-grid span,\n.model-hint-grid span {\n  display: block;\n  color: var(--subtle);\n  font-size: 11px;\n  font-weight: 700;\n}\n\n.active-model-grid strong,\n.model-hint-grid strong {\n  display: block;\n  margin: 4px 0 8px;\n  color: var(--text);\n  font-size: 13px;\n  overflow-wrap: anywhere;\n}\n\n.settings-warning {\n  margin: 14px 0 0;\n  color: var(--accent-dark);\n  font-size: 13px;\n  font-weight: 650;\n}\n\n.settings-details {\n  border: 1px solid var(--line);\n  border-radius: var(--radius-sm);\n  padding: 12px 14px;\n  background: var(--surface);\n}\n\n.settings-details summary {\n  padding: 0;\n}\n\n.advice-evidence-list {\n  display: grid;\n  gap: 12px;\n}\n\n.advice-evidence-list article {\n  padding: 14px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-sm);\n  background: var(--surface-muted);\n}\n\n.embedding-provider-choice {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n  margin-bottom: 16px;\n}\n\n.embedding-provider-choice button {\n  min-height: 118px;\n  padding: 14px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  text-align: left;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.embedding-provider-choice button.active {\n  border-color: var(--accent-border);\n  background: var(--accent-bg);\n  box-shadow: var(--shadow-sm);\n}\n\n.embedding-provider-choice strong {\n  color: var(--text);\n  font-size: 14px;\n}\n\n.embedding-provider-choice span {\n  color: var(--muted);\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n/* Sticky Bottom Action bar */\n.sticky-action {\n  position: sticky;\n  bottom: 16px;\n  z-index: 20;\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  padding: 14px 20px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: rgba(255, 255, 255, 0.9);\n  backdrop-filter: blur(8px);\n  box-shadow: var(--shadow-lg);\n}\n\n.save-note {\n  color: var(--success);\n  font-size: 12px;\n  font-weight: 600;\n}\n\n/* Progress Panel (Skeleton during Analysis) */\n.progress-panel {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: var(--space-sm);\n}\n\n.progress-panel div {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 12px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius-sm);\n  background: var(--surface);\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 600;\n  transition: all 250ms ease;\n}\n\n.progress-panel div.active {\n  border-color: var(--accent-border);\n  color: var(--accent-dark);\n  background: var(--accent-bg);\n  box-shadow: var(--shadow-sm);\n}\n\n.progress-panel span {\n  display: grid;\n  place-items: center;\n  width: 20px;\n  height: 20px;\n  border-radius: 999px;\n  background: var(--surface-strong);\n  font-size: 11px;\n  font-weight: 700;\n  color: var(--text);\n}\n\n.progress-panel div.active span {\n  background: var(--accent);\n  color: var(--surface);\n}\n\n/* DECISION SUMMARY CARD (Result Page Main Showcase) */\n.decision-card {\n  border-color: var(--line-strong);\n  box-shadow: var(--shadow-lg);\n  position: relative;\n  overflow: hidden;\n  background: linear-gradient(135deg, var(--surface) 0%, #faf9f7 100%);\n}\n\n.decision-card::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 4px;\n  height: 100%;\n}\n\n/* Left side colors depending on decision status */\n.decision-card.decision-strong_yes::before { background: var(--success); }\n.decision-card.decision-yes::before { background: var(--success); }\n.decision-card.decision-maybe::before { background: var(--warning); }\n.decision-card.decision-no::before { background: var(--danger); }\n\n.decision-layout {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 32px;\n}\n\n.decision-layout h2 {\n  font-size: 32px;\n  font-weight: 850;\n  letter-spacing: -0.04em;\n  margin-bottom: 8px;\n  color: var(--text);\n}\n\n.decision-layout p {\n  font-size: 15px;\n  margin-bottom: var(--space-md);\n  color: var(--muted);\n  max-width: 620px;\n}\n\n.badge-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n}\n\n/* Score Ring with Modern Circular/Graphite Style */\n.score-ring {\n  width: 124px;\n  aspect-ratio: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  border-radius: 999px;\n  border: 8px solid var(--surface-muted);\n  background: var(--surface);\n  box-shadow: var(--shadow-md);\n  flex-shrink: 0;\n}\n\n/* Decision Details Grid - Pros/Cons */\n.decision-details-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 24px;\n  margin-top: 24px;\n  border-top: 1px solid var(--line);\n  padding-top: 20px;\n}\n\n.decision-pros h4,\n.decision-cons h4 {\n  font-size: 13px;\n  font-weight: 700;\n  margin-bottom: var(--space-sm);\n  color: var(--text);\n  display: flex;\n  align-items: center;\n}\n\n.pros-tags,\n.cons-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.pro-tag {\n  background: var(--success-bg);\n  border: 1px solid var(--success-border);\n  color: var(--success);\n  font-size: 11px;\n  font-weight: 600;\n  padding: 3px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.con-tag {\n  background: var(--danger-bg);\n  border: 1px solid var(--danger-border);\n  color: var(--danger);\n  font-size: 11px;\n  font-weight: 600;\n  padding: 3px 8px;\n  border-radius: var(--radius-sm);\n}\n\n.neutral-tag {\n  color: var(--subtle);\n  font-size: 12px;\n}\n\n.decision-card.decision-strong_yes .score-ring,\n.decision-card.decision-yes .score-ring {\n  border-color: var(--success-border);\n}\n\n.decision-card.decision-maybe .score-ring {\n  border-color: var(--warning-border);\n}\n\n.decision-card.decision-no .score-ring {\n  border-color: var(--danger-border);\n}\n\n.score-ring strong {\n  display: block;\n  color: var(--text);\n  font-size: 32px;\n  font-weight: 900;\n  letter-spacing: -0.02em;\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n}\n\n.score-ring span {\n  color: var(--subtle);\n  font-size: 10px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-top: 2px;\n}\n\n/* Badge Primitive Styles */\n.badge {\n  display: inline-flex;\n  align-items: center;\n  min-height: 24px;\n  padding: 0 10px;\n  border-radius: 999px;\n  border: 1px solid var(--line);\n  background: var(--surface-muted);\n  color: var(--muted);\n  font-size: 11px;\n  font-weight: 650;\n  letter-spacing: 0.01em;\n}\n\n.badge-success {\n  border-color: var(--success-border);\n  background: var(--success-bg);\n  color: var(--success);\n}\n\n.badge-warning {\n  border-color: var(--warning-border);\n  background: var(--warning-bg);\n  color: var(--warning);\n}\n\n.badge-danger {\n  border-color: var(--danger-border);\n  background: var(--danger-bg);\n  color: var(--danger);\n}\n\n.badge-info {\n  border-color: var(--info-border);\n  background: var(--info-bg);\n  color: var(--info);\n}\n\n/* Match Breakdown List */\n.dimension-list,\n.history-list,\n.project-editor-list,\n.compact-history {\n  display: grid;\n  gap: 14px;\n}\n\n@media (min-width: 1024px) {\n  .history-list {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 20px;\n  }\n}\n\n.project-editor-card {\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: #fcfbfa;\n  padding: 20px;\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n  transition: all 150ms ease;\n}\n\n.project-editor-card:hover {\n  border-color: var(--line-strong);\n  background: var(--surface);\n  box-shadow: var(--shadow-sm);\n}\n\n.project-editor-card .btn-danger {\n  align-self: flex-start;\n  margin-top: 4px;\n}\n\n.profile-editor {\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n\n\n\n.dimension-row {\n  display: grid;\n  grid-template-columns: 1fr minmax(180px, 240px);\n  gap: 20px;\n  padding: 18px 20px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  align-items: center;\n}\n\n.dimension-row strong {\n  font-size: 14px;\n  font-weight: 700;\n  color: var(--text);\n  display: block;\n  margin-bottom: 4px;\n}\n\n.dimension-row p {\n  margin-bottom: var(--space-sm);\n  font-size: 13px;\n  color: var(--muted);\n}\n\n.dimension-meter {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.dimension-meter span {\n  align-self: flex-end;\n  font-weight: 750;\n  font-size: 13px;\n  color: var(--text);\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n}\n\n.dimension-meter div {\n  height: 6px;\n  overflow: hidden;\n  border-radius: 999px;\n  background: var(--surface-strong);\n}\n\n.dimension-meter i {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  background: var(--primary); /* Muted Graphite bar indicator */\n  transition: width 800ms cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n/* Dynamic Tags */\n.tag-row {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 6px;\n}\n\n.tag-row span,\n.tag-row button {\n  border: 1px solid var(--line);\n  border-radius: 999px;\n  background: var(--surface-muted);\n  color: var(--muted);\n  padding: 4px 10px;\n  font-size: 11px;\n  font-weight: 600;\n  line-height: 1.2;\n  transition: all 150ms ease;\n}\n\n.tag-row button {\n  min-height: 26px;\n  display: inline-flex;\n  align-items: center;\n}\n\n.tag-row button:hover {\n  background: var(--surface-strong);\n  color: var(--text);\n  border-color: var(--line-strong);\n}\n\n/* Resume Advice Section and Items */\n.advice-section {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  margin-bottom: 24px;\n}\n\n.advice-section:last-child {\n  margin-bottom: 0;\n}\n\n.advice-section h3 {\n  font-size: 14px;\n  font-weight: 750;\n  color: var(--muted);\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n  border-left: 2px solid var(--line-strong);\n  padding-left: 8px;\n  margin-bottom: 6px;\n  margin-top: 4px;\n}\n\n.advice-card {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  padding: 20px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  transition: border-color 200ms ease;\n  position: relative;\n}\n\n.advice-card:hover {\n  border-color: var(--line-strong);\n}\n\n.advice-head {\n  display: flex;\n  justify-content: space-between;\n  gap: 16px;\n  align-items: center;\n}\n\n.advice-head span {\n  color: var(--accent); /* Estimated gain shown as accent */\n  font-size: 12px;\n  font-weight: 650;\n}\n\n.advice-body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-md);\n  margin-top: 4px;\n}\n\n.advice-issue,\n.advice-suggestion,\n.advice-example {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.advice-issue strong,\n.advice-suggestion strong,\n.advice-example strong {\n  font-size: 11px;\n  font-weight: 750;\n  color: var(--subtle);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n  margin-bottom: 2px;\n}\n\n.advice-issue p,\n.advice-suggestion p {\n  margin-bottom: 0;\n  font-size: 13.5px;\n  color: var(--text);\n  line-height: 1.6;\n}\n\n.example-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n}\n\n.copy-btn {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  color: var(--muted);\n  font-size: 11px;\n  font-weight: 600;\n  border-radius: var(--radius-sm);\n  padding: 4px 10px;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  min-height: 24px;\n  cursor: pointer;\n  box-shadow: var(--shadow-sm);\n  transition: all 150ms ease;\n  opacity: 0.7;\n}\n\n.copy-btn:hover {\n  opacity: 1;\n  background: var(--surface-muted);\n  color: var(--text);\n  border-color: var(--line-strong);\n  transform: translateY(-1px);\n}\n\n.copy-btn.copied {\n  opacity: 1;\n  background: var(--success-bg);\n  border-color: var(--success-border);\n  color: var(--success);\n  box-shadow: none;\n}\n\n\n/* Before / After comparisons in Quote */\nblockquote {\n  margin: var(--space-xs) 0 0;\n  padding: 12px 16px;\n  border-left: 3px solid var(--accent);\n  background: var(--surface-muted);\n  color: var(--text);\n  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;\n  font-size: 13px;\n  line-height: 1.6;\n  position: relative;\n}\n\n/* Next Actions list */\n.action-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  margin: 0;\n  padding-left: 20px;\n  color: var(--text);\n  font-size: 13px;\n}\n\n.action-list li {\n  line-height: 1.6;\n}\n\n/* Learning Milestones / Timeline */\n.learning-details {\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  padding: 16px 20px;\n  transition: all 250ms ease;\n}\n\nsummary {\n  color: var(--text);\n  font-weight: 750;\n  font-size: 14px;\n  cursor: pointer;\n  padding: var(--space-xs) 0;\n  user-select: none;\n}\n\n.learning-details[open] {\n  padding-bottom: 24px;\n}\n\n.learning-details[open] summary {\n  border-bottom: 1px solid var(--line);\n  margin-bottom: 18px;\n  padding-bottom: 10px;\n  color: var(--accent);\n}\n\n.timeline {\n  display: grid;\n  gap: 18px;\n}\n\n.timeline article {\n  display: grid;\n  grid-template-columns: 28px 1fr;\n  gap: 16px;\n}\n\n.timeline article > span {\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  border-radius: 999px;\n  background: var(--surface-muted);\n  color: var(--text);\n  font-size: 12px;\n  font-weight: 800;\n  border: 1px solid var(--line);\n}\n\n.timeline h3 {\n  font-size: 14px;\n  font-weight: 700;\n  margin-bottom: 4px;\n  color: var(--text);\n}\n\n.timeline p {\n  margin-bottom: 4px;\n  font-size: 12px;\n  color: var(--muted);\n}\n\n.timeline small {\n  color: var(--subtle);\n  font-size: 11px;\n  display: block;\n}\n\n/* Sticky Result Page Action bar */\n.next-action-bar {\n  position: sticky;\n  bottom: 16px;\n  z-index: 20;\n  padding: 14px var(--space-lg);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: rgba(255, 255, 255, 0.9);\n  backdrop-filter: blur(8px);\n  box-shadow: var(--shadow-lg);\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  flex-wrap: wrap;\n}\n\n/* History Filters */\n.history-filter {\n  display: grid;\n  grid-template-columns: minmax(280px, 1fr) 180px 160px;\n  gap: var(--space-sm);\n}\n\n/* History Card wall list */\n.history-card {\n  display: flex;\n  flex-direction: column;\n  gap: 14px;\n  padding: 22px;\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  box-shadow: var(--shadow-md);\n  transition: all 200ms ease;\n}\n\n.history-card:hover {\n  box-shadow: var(--shadow-lg);\n  border-color: var(--line-strong);\n}\n\n.history-main {\n  display: flex;\n  justify-content: space-between;\n  gap: 24px;\n  align-items: flex-start;\n}\n\n.history-main h3 {\n  font-size: 16px;\n  font-weight: 750;\n  margin-bottom: 4px;\n}\n\n.history-main p {\n  margin-bottom: 0;\n  font-size: 13px;\n  color: var(--muted);\n  max-width: 680px;\n}\n\n.history-main strong:last-child {\n  font-size: 28px;\n  font-weight: 900;\n  color: var(--text);\n  font-variant-numeric: tabular-nums;\n  line-height: 1;\n}\n\n.history-time {\n  color: var(--subtle);\n  font-size: 11px;\n}\n\n.history-actions {\n  display: flex;\n  align-items: center;\n  gap: var(--space-sm);\n  margin-top: 4px;\n  border-top: 1px solid var(--line);\n  padding-top: 14px;\n}\n\n.history-actions select {\n  width: auto;\n  min-height: 36px;\n  padding: 6px 28px 6px 12px;\n}\n\n/* Profile Tag Editor & Inline edit inputs */\n.tag-editor {\n  display: grid;\n  gap: var(--space-sm);\n  margin-bottom: var(--space-md);\n}\n\n.inline-input {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: var(--space-sm);\n}\n\n.inline-input button {\n  min-height: 38px;\n}\n\n/* State primitive blocks - Empty, Loading, Error */\n.empty-state,\n.loading-state,\n.error-state {\n  padding: 48px var(--space-lg);\n  border: 1px solid var(--line);\n  border-radius: var(--radius);\n  background: var(--surface);\n  text-align: center;\n  box-shadow: var(--shadow-sm);\n}\n\n.empty-state h3,\n.loading-state h3,\n.error-state h3 {\n  font-size: 16px;\n  font-weight: 700;\n  margin-bottom: var(--space-sm);\n}\n\n.empty-state p,\n.loading-state p,\n.error-state p {\n  font-size: 13px;\n  color: var(--muted);\n  max-width: 440px;\n  margin: 0 auto 20px;\n}\n\n.error-state {\n  border-color: var(--danger-border);\n  background: var(--danger-bg);\n  color: var(--danger);\n  font-weight: 600;\n}\n\n.error-state p {\n  color: var(--danger);\n  margin-bottom: 0;\n}\n\n.spinner {\n  display: inline-block;\n  width: 22px;\n  height: 22px;\n  margin: 0 auto 12px;\n  border: 2.5px solid var(--surface-strong);\n  border-top-color: var(--accent);\n  border-radius: 999px;\n  animation: spin 800ms linear infinite;\n}\n\n.latest-summary {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n\n.latest-summary h3 {\n  font-size: 15px;\n  font-weight: 700;\n  margin-bottom: 2px;\n}\n\n.latest-summary p {\n  font-size: 13px;\n  color: var(--muted);\n  margin-bottom: 8px;\n}\n\n.summary-line {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n  color: var(--muted);\n}\n\n.summary-line strong {\n  color: var(--text);\n  font-size: 24px;\n  font-weight: 850;\n  line-height: 1;\n}\n\n/* Compact history rows in dashboard card */\n.compact-history div {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 4px;\n  border-bottom: 1px solid var(--line);\n  font-size: 13px;\n}\n\n.compact-history div:last-child {\n  border-bottom: 0;\n}\n\n.compact-history strong {\n  font-weight: 600;\n  color: var(--text);\n}\n\n.compact-history span {\n  color: var(--muted);\n  font-size: 12px;\n}\n\n/* Core keyframe animations */\n@keyframes spin {\n  to {\n    transform: rotate(360deg);\n  }\n}\n\n/* Skeleton Loading Pulses */\n.skeleton-pulse {\n  background: linear-gradient(90deg, var(--surface-muted) 25%, var(--surface-strong) 37%, var(--surface-muted) 63%);\n  background-size: 400%