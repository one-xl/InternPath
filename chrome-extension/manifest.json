{
  "manifest_version": 3,
  "name": "实习通职位导入助手",
  "version": "1.0.0",
  "description": "实习通（InternPath）工作台的一键职位抓取与导入助手，支持 BOSS直聘 和 牛客网。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "cookies",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:8787/*",
    "http://127.0.0.1:8787/*",
    "http://localhost:5173/*",
    "http://127.0.0.1:5173/*",
    "https://*.zhipin.com/*",
    "https://*.nowcoder.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhipin.com/job_detail/*.html*",
        "https://*.nowcoder.com/jobs/detail/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
