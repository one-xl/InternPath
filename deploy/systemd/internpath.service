[Unit]
Description=InternPath FastAPI Service
After=network.target postgresql.service redis-server.service internpath-ai.service internpath-worker.service internpath-advisor-worker.service
Wants=postgresql.service redis-server.service internpath-ai.service internpath-worker.service internpath-advisor-worker.service

[Service]
Type=simple
User=internpath
Group=internpath
WorkingDirectory=/opt/internpath
EnvironmentFile=/opt/internpath/.env
Environment=HOME=/opt/internpath
Environment=XDG_CACHE_HOME=/opt/internpath/.cache
ExecStart=/opt/internpath/.venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8502
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/opt/internpath
UMask=0077

[Install]
WantedBy=multi-user.target
